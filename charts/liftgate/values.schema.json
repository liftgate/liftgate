{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "controlPlane",
    "dashboard",
    "postgres",
    "nats",
    "gateway",
    "deployDomain",
    "publicUrl",
    "dashboardUrl",
    "github",
    "google",
    "gitlab",
    "bitbucket",
    "email",
    "passkeys",
    "secrets",
    "registry",
    "build",
    "prometheusUrl"
  ],
  "if": { "required": ["registryAuth"], "properties": { "registryAuth": { "const": "token" } } },
  "then": {
    "required": ["registryTokenKey", "registryTokenCertificate", "registryPullPassword", "registryJanitorPassword"],
    "properties": {
      "registryTokenKey": { "minLength": 1 },
      "registryTokenCertificate": { "minLength": 1 },
      "registryPullPassword": { "minLength": 1 },
      "registryJanitorPassword": { "minLength": 1 }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "profile": { "type": "string", "enum": ["single", "ha"] },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag", "replicas", "logLevel", "trustedProxies", "javaOpts", "resources", "clientIpHeader", "upstreamOverwritesClientIpHeader", "trustedProxyCidrs", "databasePoolSize"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "replicas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "reconciler", "builder", "meter"],
          "properties": {
            "api": { "type": "integer", "minimum": 1 },
            "reconciler": { "type": "integer", "minimum": 1 },
            "builder": { "type": "integer", "minimum": 1 },
            "meter": { "type": "integer", "minimum": 1 }
          }
        },
        "logLevel": { "type": "string", "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR"] },
        "trustedProxies": { "type": "integer", "minimum": 0 },
        "javaOpts": { "type": "string" },
        "resources": { "type": "object" },
        "clientIpHeader": { "type": "string" },
        "upstreamOverwritesClientIpHeader": { "type": "boolean" },
        "trustedProxyCidrs": { "type": "array", "items": { "type": "string" } },
        "databasePoolSize": { "type": "integer", "minimum": 0 }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag", "resources"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "landing": { "type": "boolean" },
        "resources": { "type": "object" }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managed", "externalUrl", "externalUser", "externalPassword", "storage", "maxConnections", "backup"],
      "properties": {
        "managed": { "type": "boolean" },
        "externalUrl": { "type": "string" },
        "externalUser": { "type": "string" },
        "externalPassword": { "type": "string" },
        "storage": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|k|M|G|T)?$" },
        "maxConnections": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "endpointUrl", "destinationPath", "credentialsSecret", "retention", "schedule", "serverName", "recoverFrom", "recoverTo"],
          "properties": {
            "enabled": { "type": "boolean" },
            "endpointUrl": { "type": "string", "pattern": "^(https?://.*)?$" },
            "destinationPath": { "type": "string", "pattern": "^(s3://[^/]+.*)?$" },
            "credentialsSecret": { "type": "string", "minLength": 1 },
            "retention": { "type": "string", "pattern": "^[1-9][0-9]*[dwm]$" },
            "schedule": { "type": "string", "minLength": 1 },
            "serverName": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$" },
            "recoverFrom": { "type": "string" },
            "recoverTo": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2}))?$" }
          },
          "allOf": [
            {
              "if": { "properties": { "recoverFrom": { "minLength": 1 } } },
              "then": { "properties": { "enabled": { "const": true } } }
            },
            {
              "if": { "properties": { "recoverTo": { "minLength": 1 } } },
              "then": { "properties": { "recoverFrom": { "minLength": 1 } } }
            }
          ]
        }
      },
      "if": { "properties": { "managed": { "const": false } } },
      "then": {
        "properties": {
          "externalUrl": { "pattern": "^jdbc:postgresql://" },
          "externalUser": { "minLength": 1 }
        }
      }
    },
    "nats": {
      "type": "object",
      "required": ["managed", "externalUrl"],
      "properties": {
        "managed": { "type": "boolean" },
        "externalUrl": { "type": "string" }
      },
      "if": { "properties": { "managed": { "const": false } } },
      "then": { "properties": { "externalUrl": { "pattern": "^(nats|tls)://" } } }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "className", "wildcardSecret", "issuer"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string" },
        "className": { "type": "string", "minLength": 1 },
        "wildcardSecret": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 }
      }
    },
    "deployDomain": { "type": "string", "minLength": 1, "maxLength": 189 },
    "publicUrl": { "type": "string", "pattern": "^https?://" },
    "dashboardUrl": { "type": "string", "pattern": "^(https?://.*)?$" },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "clientId", "clientSecret", "webhookSecret", "privateKey"],
      "properties": {
        "appId": { "type": ["string", "integer"] },
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" },
        "webhookSecret": { "type": "string" },
        "privateKey": { "type": "string" }
      }
    },
    "google": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "clientSecret"],
      "properties": {
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" }
      }
    },
    "gitlab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "clientId", "clientSecret"],
      "properties": {
        "url": { "type": "string", "pattern": "^(https://.*)?$" },
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" },
        "trustEmail": { "type": ["boolean", "null"] }
      }
    },
    "bitbucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "clientSecret"],
      "properties": {
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smtpUrl", "from"],
      "properties": {
        "smtpUrl": { "type": "string", "pattern": "^(smtps?://.*)?$" },
        "from": { "type": "string" }
      }
    },
    "passkeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rpId", "rpName"],
      "properties": {
        "rpId": { "type": "string", "pattern": "^[a-z0-9.-]*$" },
        "rpName": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["masterKey"],
      "properties": {
        "masterKey": { "type": "string" }
      }
    },
    "registry": { "type": "string", "minLength": 1 },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "namespace"],
      "properties": {
        "image": { "type": "string" },
        "namespace": { "type": "string", "minLength": 1 },
        "registryCredentials": { "type": "string" },
        "allowedEgressCidrs": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["cidr", "ports"],
                "properties": {
                  "cidr": { "type": "string", "minLength": 1 },
                  "ports": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
                }
              }
            ]
          }
        },
        "nodeSelector": { "$ref": "#/definitions/nodeSelector" },
        "tolerations": { "$ref": "#/definitions/tolerations" },
        "logsMaxBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "runtimeClass": { "type": "string" },
    "nodeSelector": { "$ref": "#/definitions/nodeSelector" },
    "registryInsecure": { "type": "boolean" },
    "registryAuth": { "type": "string", "enum": ["shared", "token"] },
    "registryTokenKey": { "type": "string" },
    "registryTokenCertificate": { "type": "string" },
    "registryPullPassword": { "type": "string" },
    "registryJanitorPassword": { "type": "string" },
    "prometheusUrl": { "type": "string", "pattern": "^https?://" },
    "signup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allow"],
      "properties": {
        "mode": { "type": "string", "enum": ["open", "approval", "closed"] },
        "allow": { "type": "array", "items": { "type": "string", "pattern": "^(github:[A-Za-z0-9-]+|@[^@ ]+|[^@ ]+@[^@ ]+)$" } }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "termsUrl": { "type": "string", "pattern": "^(https?://.*)?$" },
        "privacyUrl": { "type": "string", "pattern": "^(https?://.*)?$" },
        "aupUrl": { "type": "string", "pattern": "^(https?://.*)?$" }
      }
    },
    "customDomains": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "max": { "type": ["integer", "null"], "minimum": 0 },
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zoneId": { "type": "string" },
            "apiToken": { "type": "string" },
            "cnameTarget": { "type": "string" },
            "gatewayServerName": { "type": "string" }
          },
          "if": { "properties": { "zoneId": { "minLength": 1 } }, "required": ["zoneId"] },
          "then": { "properties": { "apiToken": { "minLength": 1 }, "gatewayServerName": { "minLength": 1 } }, "required": ["apiToken", "gatewayServerName"] }
        }
      }
    },
    "allowSharedSite": { "type": "boolean" },
    "allowUnsandboxedTenants": { "type": "boolean" },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": { "$ref": "#/definitions/nodeSelector" },
        "tolerations": { "$ref": "#/definitions/tolerations" }
      }
    },
    "plans": { "type": "object", "minProperties": 1, "propertyNames": { "not": { "const": "default" } }, "additionalProperties": { "$ref": "#/definitions/plan" } },
    "defaultPlan": { "type": "string", "minLength": 1 },
    "deniedEgressCidrs": { "type": "array", "items": { "type": "string", "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/([1-9]|[12][0-9]|3[0-2])$" } }
  },
  "definitions": {
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+(=[A-Za-z0-9_.-]*)?(:(NoSchedule|PreferNoSchedule|NoExecute))?$" }
    },
    "limit": { "type": "integer", "minimum": 0 },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownedOrgs": { "$ref": "#/definitions/limit" },
        "projects": { "$ref": "#/definitions/limit" },
        "environmentsPerProject": { "$ref": "#/definitions/limit" },
        "services": { "$ref": "#/definitions/limit" },
        "cpuMillis": { "$ref": "#/definitions/limit" },
        "memoryMb": { "$ref": "#/definitions/limit" },
        "replicas": { "$ref": "#/definitions/limit" },
        "cpuRequestRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "ephemeralMb": { "type": "integer", "minimum": 1 },
        "customDomains": { "$ref": "#/definitions/limit" },
        "concurrentBuilds": { "$ref": "#/definitions/limit" },
        "buildsPerHour": { "$ref": "#/definitions/limit" },
        "egressBandwidth": { "type": "string", "pattern": "^[0-9]+[kMG]?$" },
        "udp": { "type": "boolean" },
        "cronTimeoutSeconds": { "type": "integer", "minimum": 1 }
      },
      "dependencies": { "concurrentBuilds": ["buildsPerHour"] }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": { "const": "ha" },
          "postgres": { "properties": { "managed": { "const": true } } }
        }
      },
      "then": {
        "properties": { "postgres": { "properties": { "backup": { "properties": { "enabled": { "const": true } } } } } }
      }
    }
  ]
}
